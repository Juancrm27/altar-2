{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "header": {
      "type": "header",
      "settings": {
        "header_style": "altar",
        "logo_position_desktop": "left",
        "section_width": "full",
        "vertical_padding": 0,
        "horizontal_padding": 0,
        "use_different_mobile_padding": true,
        "vertical_padding_mobile": 0,
        "horizontal_padding_mobile": 0,
        "head_fix_desktop": true
      },
      "blocks": {
        "logo": {
          "type": "header-logo",
          "settings": {
            "height": 40,
            "use_different_mobile_height": false
          }
        },
        "utilities": {
          "type": "header-utilities",
          "settings": {
            "format": "icons_text",
            "search_type": "icon",
            "cart_icon": "bag",
            "show_languages_header": false
          }
        },
        "navigation": {
          "type": "header-navigation",
          "settings": {
            "nav_uppercase": true,
            "show_categories_link": false,
            "show_mobile_categories": false,
            "nav_alignment_desktop": "center",
            "vertical_padding": 0,
            "items_gap": 18,
            "show_secondary_menu": false
          }
        }
      },
      "block_order": [
        "logo",
        "utilities",
        "navigation"
      ]
    }
  },
  "order": [
    "header"
  ]
}
