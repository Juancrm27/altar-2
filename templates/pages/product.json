{
  "sections": {
    "main_product": {
      "type": "main-product",
      "settings": {
        "section_width": "page",
        "column_gap": 20,
        "vertical_padding": 32
      },
      "blocks": {
        "product_media": {
          "type": "product-media",
          "settings": {
            "show_thumbnails": false,
            "thumbnail_position": "left",
            "format": "grid",
            "columns": "1",
            "gap": 7
          }
        },
        "product_info": {
          "type": "product-info",
          "settings": {
            "gap": 40,
            "vertical_padding": 8,
            "horizontal_padding": 0,
            "altar_maker_label": "Maker",
            "altar_installments_label": "Cuotas",
            "altar_payments_label": "Medios de pago",
            "altar_stock_label": "Stock",
            "altar_stock_available_label": "Disponible",
            "altar_shipping_label": "Envío",
            "altar_shipping_note": "Calculá el costo y el tiempo de entrega con tu código postal."
          },
          "blocks": {
            "description": {
              "type": "description",
              "settings": {
                "show_title": true,
                "show_social": false
              }
            },
            "purchase_info": {
              "type": "purchase-info",
              "settings": {
                "icon_size": 24,
                "title_size": "paragraph",
                "description_size": "paragraph_small",
                "gap": 24
              },
              "blocks": {
                "icon_returns": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "returns",
                    "title": "Cambios",
                    "description": "Tenés 30 días para cambiar o devolver tu compra. Si llega dañada, escribinos y lo resolvemos."
                  }
                },
                "icon_security": {
                  "type": "icon-text-item",
                  "settings": {
                    "icon": "security",
                    "title": "Pago seguro",
                    "description": "Pagá con tarjeta, transferencia o efectivo. Tus datos viajan protegidos."
                  }
                }
              },
              "block_order": [
                "icon_returns",
                "icon_security"
              ]
            }
          },
          "block_order": [
            "description",
            "purchase_info"
          ]
        }
      },
      "block_order": [
        "product_media",
        "product_info"
      ]
    },
    "complementary_products": {
      "type": "related-products",
      "settings": {
        "products_source": "complementary",
        "section_width": "page",
        "gap": 16,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "complementary_heading": {
          "type": "heading",
          "settings": {
            "title": "Productos relacionados",
            "size": "h2"
          }
        },
        "complementary_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "complementary_heading",
        "complementary_products_block"
      ]
    },
    "alternative_products": {
      "type": "related-products",
      "settings": {
        "products_source": "alternative",
        "section_width": "page",
        "gap": 16,
        "vertical_padding": 0,
        "horizontal_padding": 0
      },
      "blocks": {
        "alternative_heading": {
          "type": "heading",
          "settings": {
            "title": "Productos relacionados",
            "size": "h2"
          }
        },
        "alternative_products_block": {
          "type": "product-recommendations",
          "settings": {
            "columns": "4",
            "columns_mobile": "2"
          }
        }
      },
      "block_order": [
        "alternative_heading",
        "alternative_products_block"
      ]
    }
  },
  "order": [
    "main_product",
    "complementary_products",
    "alternative_products"
  ]
}
